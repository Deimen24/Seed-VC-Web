# Copy to .env to override defaults. The server, run scripts and the
# service all read this file.

# --- network --------------------------------------------------------------
# SEEDVC_WEB_PORT=7870
# SEEDVC_WEB_HOST=127.0.0.1       # the service always listens on 0.0.0.0
# SEEDVC_WEB_MAX_UPLOAD_MB=200

# --- reverse proxy on another machine ------------------------------------
# SEEDVC_WEB_ROOT_PATH=/voice     # only when served under a sub-path
# SEEDVC_WEB_FORWARDED_ALLOW_IPS=192.168.1.10   # proxy IP, or * for any
# SEEDVC_WEB_BASIC_AUTH=user:password           # if the proxy does not authenticate

# --- paths / hardware -----------------------------------------------------
# SEEDVC_WEB_DEVICE=auto          # cuda | cpu | auto
# SEEDVC_WEB_DATA_DIR=D:\seed-vc-web-data   # uploads, outputs, model cache
# SEEDVC_WEB_SEEDVC_DIR=vendor/seed-vc
# SEEDVC_WEB_LOG_FILE=data/logs/server.log
# HF_ENDPOINT=https://hf-mirror.com     # if huggingface.co is unreachable
